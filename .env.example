# AI Provider: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Google Gemini API key (required when AI_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
OPENAI_MODEL=gpt-4o-realtime-preview

# How long Gemini waits on silence before treating the learner turn as finished (ms)
GEMINI_SILENCE_MS=900
GEMINI_PREFIX_PADDING_MS=300

# LiveKit (defaults match docker-compose)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Required for local WebRTC: your Mac LAN IP (ipconfig getifaddr en0)
LIVEKIT_NODE_IP=127.0.0.1

# Frontend / Auth
DATABASE_URL=file:./dev.db
# REQUIRED, 32+ random characters (the app refuses to start in production otherwise):
#   openssl rand -base64 48
AUTH_SECRET=
# Optional seeded admin account (skipped if ADMIN_PASSWORD is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to "false" to close public sign-up
ALLOW_SIGNUP=true
