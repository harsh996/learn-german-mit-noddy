datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique // stored lowercase
  email         String?   @unique // stored lowercase; nullable only for pre-existing accounts
  emailVerified DateTime?
  password      String
  createdAt     DateTime  @default(now())
  profiles Profile[]
  savedWords SavedWord[]
  preferences UserPreference?
}

model Profile {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  level        String
  avatarGender String
  avatarName   String
  createdAt    DateTime        @default(now())
  readingPrefs String          @default("{}")
  memories     ProfileMemory[]
  sessions     SessionLog[]
  reading      ReadingProgress[]
  savedWords   SavedWord[]
}

model ReadingProgress {
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  storyId   String
  progress  Float
  updatedAt DateTime @updatedAt

  @@id([profileId, storyId])
}

model ProfileMemory {
  id              String   @id @default(uuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category        String
  errorPattern    String
  correctionNote  String
  occurrenceCount Int      @default(1)
  lastSeenAt      DateTime @default(now())
}

model SessionLog {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  summary     String
  newMistakes String
}

model SavedWord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable only so pre-existing rows survive the migration; the entrypoint assigns them to a profile.
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  wordKey     String
  word        String
  article     String?
  pos         String?
  level       String?
  translation String
  createdAt   DateTime @default(now())

  @@unique([profileId, wordKey])
  @@index([profileId, createdAt])
}

model UserPreference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab  String @default("{}")
}
